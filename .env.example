# Copy to .env and fill in. Never commit the real .env (already in .gitignore).

OPENAI_API_KEY=sk-your-key-here

POSTGRES_DB=garden_companion
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Dagster needs DAGSTER_HOME to be an ABSOLUTE path, so it can't just be
# ".dagster_home" here (that's not portable across machines anyway). Set
# it inline instead, when you run dagster dev:
#
#   DAGSTER_HOME=$(pwd)/.dagster_home uv run dagster dev -f ingestion/definitions.py
#
# The shell resolves $(pwd) to an absolute path automatically. Without this,
# dagster dev creates a randomly-named .tmp_dagster_home_* folder in the
# project root on every run, and you lose materialization history each time.

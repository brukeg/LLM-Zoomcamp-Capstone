# Copy to .env and fill in. Never commit the real .env (already in .gitignore).

OPENAI_API_KEY=sk-your-key-here

POSTGRES_DB=garden_companion
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Without this, `dagster dev` creates a randomly-named .tmp_dagster_home_*
# folder in the project root on every run. Fixed path, gitignored below.
DAGSTER_HOME=.dagster_home
